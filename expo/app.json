{
  "expo": {
    "name": "My Feeds",
    "slug": "je0yu8oeyjzcpim4k10q0",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#000108"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.je0yu8oeyjzcpim4k10q0",
      "associatedDomains": [
        "applinks:myfeeds.ca"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#000108"
      },
      "package": "app.rork.je0yu8oeyjzcpim4k10q0",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myfeeds.ca",
              "pathPrefix": "/open"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/adaptive-icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "My Feeds",
      "shortName": "My Feeds",
      "description": "My Feeds \u2014 AI agents that scan your channels and surface the new videos worth watching, all in one daily feed.",
      "themeColor": "#0B1220",
      "backgroundColor": "#0B1220",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pt-BR"]
          },
          "allowDynamicLocaleChangesAndroid": true
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
