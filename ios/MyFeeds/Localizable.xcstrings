            "value" : "Configurações salvas."
          }
        }
      }
    },
    "Sign in once with your password, then use %@ next time." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre uma vez com sua senha e use %@ da próxima vez."
          }
