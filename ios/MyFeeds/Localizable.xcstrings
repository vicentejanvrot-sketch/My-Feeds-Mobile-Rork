    "Running or walking with the phone in your pocket? Tap the lock icon in the video player to turn on Pocket Lock. The screen goes dark and ignores every touch while the video keeps playing. Press and hold the lock for 2 seconds to unlock." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correndo ou caminhando com o celular no bolso? Toque no ícone de cadeado no player para ativar o Bloqueio de bolso. A tela escurece e ignora todos os toques enquanto o vídeo continua tocando. Toque e segure o cadeado por 2 segundos para desbloquear."
          }
        }
      }
    },
    "SIGNED IN AS" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CONECTADO COMO"
          }
        }
      }
    },
    "Save" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar"
          }
        }
      }
    },
    "Save your login by signing out and signing back in with your password." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve seu login saindo e entrando de novo com sua senha."
          }
        }
      }
    },
    "Saved for offline" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvos para ver offline"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurações"
          }
        }
      }
    },
    "Settings saved." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
