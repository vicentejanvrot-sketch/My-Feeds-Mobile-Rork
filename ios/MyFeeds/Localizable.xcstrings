                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This deletes the collection, its %lld sources, its email recipients, its run history and every video and post it found, including ones you saved. It can't be undone. Your accounts on YouTube, X and the other platforms aren't touched."
