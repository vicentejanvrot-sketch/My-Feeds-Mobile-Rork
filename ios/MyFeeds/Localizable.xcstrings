                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "sua %arg pessoa ou empresa"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "cada uma das suas %arg pessoas e empresas"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks %#@people@ once: the links on their profile, their link-in-bio page and website, and handles like theirs on other platforms. Each person is searched once, across all the places you follow them, using at most %2$lld to 30 lookups, so up to about $%3$@ for this first check."
          },
          "substitutions" : {
            "people" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
