          }
        }
      }
    },
    "Permanently delete your account and all associated data. This action cannot be undone." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua permanentemente sua conta e todos os dados associados. Essa ação não pode ser desfeita."
