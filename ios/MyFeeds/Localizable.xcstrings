    },
    "API keys (YouTube, OpenAI, Anthropic, Gemini) are optional and let the app fetch video data and run AI analysis on your behalf. Keys are stored securely and are never displayed back to you after saving." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de API (YouTube, OpenAI, Anthropic, Gemini) são opcionais e permitem que o app busque dados de vídeos e faça análises com IA por você. As chaves são guardadas com segurança e nunca são exibidas de novo depois de salvas."
          }
        }
      }
    },
