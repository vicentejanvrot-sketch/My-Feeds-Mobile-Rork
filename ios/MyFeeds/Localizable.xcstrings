    "Connect your YouTube account to add songs to a \"My Feeds\" playlist in YouTube Music." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte sua conta do YouTube para adicionar músicas a uma playlist \"My Feeds\" no YouTube Music."
